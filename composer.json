{
    "name": "lazarusphp/framework",
    "description": "A small slim framework app in php",
    "type": "project",
    "license": "GPL",
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Console\\":"Console/",
            "LazarusPhp\\QueryBuilder\\":"Dev/QueryBuilder/src",
            "LazarusPhp\\Authentication\\":"Dev/Authentication/src",
            "LazarusPhp\\Logger\\":"Dev/Logger/src",
            "LazarusPhp\\DateManager\\": "Dev/DateManager/src",
            "LazarusPhp\\Exceptions\\": "Dev/Exceptions/src",
            "LazarusPhp\\SessionManager\\":"Dev/SessionManager/src",
            "LazarusPhp\\Requests\\":"Dev/Requests/src",
            "LazarusPhp\\Database\\":"Dev/Database/src",
            "LazarusPhp\\PathResolver\\":"Dev/PathResolver/src",
            "LazarusPhp\\Core\\":"Dev/Core/src",
            "LazarusPhp\\Security\\":"Dev/Security/src",
            "LazarusPhp\\Templating\\":"Dev/Templating/src",
            "LazarusPhp\\Console\\":"Dev/Console/src",
            "LazarusPhp\\ServiceProvider\\":"Dev/ServiceProvider/src"

        }
    },
    "autoload-dev": {
        "psr-4": {
            
        }
    },
    "prefer-stable": true,
    "authors": [
        {
            "name": "Martin Bamber"
        }
    ],
    "require-dev": {
        "fakerphp/faker": "^1.9.1"
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.0.2",
        "laminas/laminas-diactoros": "^3",
        "phpmailer/phpmailer": "^6.2",
        "miladrahimi/phprouter":"^5",
        "lazarusphp/openhandler": "^1.0.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "vlucas/phpdotenv": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "if [ ! -f.env ]; then mv .env.example .env; else echo .env already exists; fi",
            "if [ ! -f app ]; then mv app.example app; else echo file app already exists; fi",
           "if [ ! -d Storage ]; then mkdir Storage; else echo Storage directory already exists; fi",
            "chmod -R 0777 Storage",
            "chmod +x app",
            "echo Install complete"
        ],
        "post-update-cmd": [
            "if [ ! -f .env ]; then mv .env.example .env; else echo .env already exists; fi",
            "if [ ! -f app ]; then mv app.example schema; else echo  file app already exists; fi",
            "if [ ! -d Storage ]; then mkdir Storage; else echo Storage directory already exists; fi",
            "chmod -R 0777 Storage",
            "chmod +x app",
            "echo Update complete"
        ]
    }

}
